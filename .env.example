# Application
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
SETTINGS_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key
JWT_ISSUER=ccsa
JWT_AUDIENCE=ccsa-web

# PostgreSQL
POSTGRES_USER=ccsa
POSTGRES_PASSWORD=ccsa_secret
POSTGRES_DB=ccsa
DATABASE_URL=postgresql+asyncpg://ccsa:ccsa_secret@postgres:5432/ccsa

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Parallel LLM/I/O Celery tasks (STT worker stays at concurrency=1)
CELERY_LLM_CONCURRENCY=2
# Legacy name; ignored by compose (use CELERY_LLM_CONCURRENCY)
CELERY_WORKER_CONCURRENCY=1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ccsa_minio
MINIO_SECRET_KEY=ccsa_minio_secret
MINIO_BUCKET=ccsa-audio
MINIO_SECURE=false

# STT (faster-whisper INT8 + pyannote diarization)
STT_SERVICE_URL=http://stt-service:8001
STT_MODEL=OvozifyLabs/whisper-small-uz-v1
STT_CT2_UZ_MODEL_PATH=/app/models/OvozifyLabs--whisper-small-uz-v1-int8
STT_AUTO_CONVERT_CT2=false
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
STT_DIARIZATION_METHOD=stereo_channels
STT_CLIENT_CHANNEL=left
# VAD on isolated channels suppresses cross-channel bleed (the other speaker
# leaking into this channel). Recommended ON for true stereo recordings.
STT_CHANNEL_VAD_FILTER=true
STT_LANGUAGE=uz
STT_WORD_TIMESTAMPS=true
STT_TEMPERATURE=0
# Optional domain prompt for Whisper (product names, typical CC phrases)
# STT_INITIAL_PROMPT=O'zbekiston call-center suhbat. Operator, mijoz, to'lov, balans, tarif.
# Hugging Face token: pyannote licenses, gated models
HF_TOKEN=hf_your_huggingface_token_here
# Benchmark fast downloads (see benchmark/hf.env.example)
HF_HUB_ENABLE_HF_TRANSFER=1
HF_XET_HIGH_PERFORMANCE=1
HF_HUB_DOWNLOAD_TIMEOUT=600
# Optional: cache under repo (default models/hf-cache)
# HF_HUB_CACHE=

# OpenAI (optional for dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Webitel (optional)
WEBITEL_API_URL=
WEBITEL_ACCESS_TOKEN=

CORS_ORIGINS=
# Shared secret API → STT (header X-STT-Token). Required in production.
STT_SERVICE_TOKEN=ccsa-stt-internal

# Frontend
VITE_API_URL=/api/v1

# Feature toggles (optional; default true)
FEATURE_RESEARCH=true
FEATURE_PLAYGROUND=true
FEATURE_WEBITEL_SYNC=true
FEATURE_DASHBOARD_CONSTRUCTOR=true

# Timeouts
LLM_TIMEOUT_SEC=45
WEBITEL_TIMEOUT_SEC=15
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10

# Seed admin (in production SEED_ADMIN_PASSWORD must not be admin123)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123

# Research (LLM meta-analysis)
RESEARCH_MAX_CALLS=200

# Playground uploads and probes
UPLOAD_MAX_FILES=20
UPLOAD_MAX_BYTES=26214400
IDEMPOTENCY_PENDING_SECONDS=120
READINESS_TIMEOUT_SEC=2
