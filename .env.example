# Application
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
SETTINGS_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key

# PostgreSQL
POSTGRES_USER=ccsa
POSTGRES_PASSWORD=ccsa_secret
POSTGRES_DB=ccsa
DATABASE_URL=postgresql+asyncpg://ccsa:ccsa_secret@postgres:5432/ccsa

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Parallel Celery tasks per worker (also configurable in Settings → Models; requires restart)
CELERY_WORKER_CONCURRENCY=1

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ccsa_minio
MINIO_SECRET_KEY=ccsa_minio_secret
MINIO_BUCKET=ccsa-audio
MINIO_SECURE=false

# STT (faster-whisper INT8 + pyannote diarization)
STT_SERVICE_URL=http://stt-service:8001
STT_MODEL=OvozifyLabs/whisper-small-uz-v1
STT_CT2_UZ_MODEL_PATH=/app/models/OvozifyLabs--whisper-small-uz-v1-int8
STT_AUTO_CONVERT_CT2=false
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_DIARIZATION_METHOD=stereo_channels
STT_CLIENT_CHANNEL=left
# VAD on isolated channels suppresses cross-channel bleed (the other speaker
# leaking into this channel). Recommended ON for true stereo recordings.
STT_CHANNEL_VAD_FILTER=true
STT_LANGUAGE=uz
STT_WORD_TIMESTAMPS=true
STT_TEMPERATURE=0
# Hugging Face token: pyannote licenses, gated models
HF_TOKEN=hf_your_huggingface_token_here
# Benchmark fast downloads (see benchmark/hf.env.example)
HF_HUB_ENABLE_HF_TRANSFER=1
HF_XET_HIGH_PERFORMANCE=1
HF_HUB_DOWNLOAD_TIMEOUT=600
# Optional: cache under repo (default models/hf-cache)
# HF_HUB_CACHE=

# OpenAI (optional for dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Webitel (optional)
WEBITEL_API_URL=
WEBITEL_ACCESS_TOKEN=

# Frontend
VITE_API_URL=/api/v1

# Seed admin
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123

# Research (LLM meta-analysis)
RESEARCH_MAX_CALLS=200
