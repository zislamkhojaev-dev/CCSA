# Copy to benchmark/hf.env or set in project .env (HF_* keys are merged on benchmark run).
# Token: https://huggingface.co/settings/tokens (for gated models)

# One line only — do NOT paste the token alone in the terminal as a command.
HF_TOKEN=hf_your_huggingface_token_here

# Cache inside repo (optional; default: models/hf-cache)
# HF_HUB_CACHE=/absolute/path/to/CCSA/models/hf-cache

# Fast downloads (requires: pip install hf-transfer)
HF_HUB_ENABLE_HF_TRANSFER=1
HF_XET_HIGH_PERFORMANCE=1

# Timeouts for large checkpoints (~3 GB Zehnova)
HF_HUB_DOWNLOAD_TIMEOUT=600
HF_HUB_ETAG_TIMEOUT=60
